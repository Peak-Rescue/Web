-- The contract half of 109. DO NOT PUSH THIS BEFORE THE APP IS DEPLOYED.
--
-- Held as `.hold` so `supabase db push` can't pick it up by accident. Drop the
-- suffix once the Vercel build that stops reading these columns is live, then
-- push.
--
-- 109 added `gear_list_entries.note` and backfilled it from the four columns
-- dropped here. Code that still selects any of them errors on every gear list
-- the moment this runs — which is exactly how the `category` → `section`
-- rename took every course's gear list down for the length of a Vercel build.
--
-- Order: push 109, deploy the app that reads `note`, confirm the build, then
-- push this.

alter table public.gear_list_entries drop column if exists info;
alter table public.gear_list_entries drop column if exists recommended;

alter table public.gear_items drop column if exists info;
alter table public.gear_items drop column if exists recommended;
